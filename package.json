{
  "name": "variable-conversion",
  "displayName": "Variable Conversion",
  "description": "%extension.description%",
  "version": "3.0.0",
  "icon": "image/logo.compressed.png",
  "publisher": "coder-xiaomo",
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@12.11.2",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang-brook/variable-conversion-vscode-extension.git"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://git.only4.work/zhang-brook/variable-conversion-vscode-extension.git"
    },
    {
      "type": "git",
      "url": "https://gitee.com/zhang-brook/variable-conversion-vscode-extension.git"
    }
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTextSelected"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "keybindings": [
      {
        "command": "variable-conversion.convertCase",
        "key": "shift+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "variable-conversion.cyclicConvertCase.previous",
        "key": "ctrl+alt+[",
        "args": {
          "arrowKey": "["
        },
        "when": "editorTextFocus"
      },
      {
        "command": "variable-conversion.cyclicConvertCase.next",
        "key": "ctrl+alt+]",
        "args": {
          "arrowKey": "]"
        },
        "when": "editorTextFocus"
      },
      {
        "command": "variable-conversion.showConvertCaseDetailDialog",
        "key": "ctrl+alt+\\"
      },
      {
        "command": "variable-conversion.convertPath",
        "key": "shift+alt+/",
        "when": "editorTextFocus"
      },
      {
        "command": "variable-conversion.cyclicConvertPath.previous",
        "key": "ctrl+alt+shift+/",
        "args": {
          "direction": "<-"
        },
        "when": "editorTextFocus"
      },
      {
        "command": "variable-conversion.cyclicConvertPath.next",
        "key": "ctrl+alt+/",
        "args": {
          "direction": "->"
        },
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "variable-conversion.convertCase",
        "title": "%command.convertCase.title%"
      },
      {
        "command": "variable-conversion.cyclicConvertCase.previous",
        "title": "%command.cyclicConvertCase.previous.title%"
      },
      {
        "command": "variable-conversion.cyclicConvertCase.next",
        "title": "%command.cyclicConvertCase.next.title%"
      },
      {
        "command": "variable-conversion.toCamelCase",
        "title": "%command.toCamelCase.title%"
      },
      {
        "command": "variable-conversion.toPascalCase",
        "title": "%command.toPascalCase.title%"
      },
      {
        "command": "variable-conversion.toSnakeCase",
        "title": "%command.toSnakeCase.title%"
      },
      {
        "command": "variable-conversion.toSnakeUpperCase",
        "title": "%command.toSnakeUpperCase.title%"
      },
      {
        "command": "variable-conversion.toSnakePascalCase",
        "title": "%command.toSnakePascalCase.title%"
      },
      {
        "command": "variable-conversion.toSnakeCamelCase",
        "title": "%command.toSnakeCamelCase.title%"
      },
      {
        "command": "variable-conversion.toKebabCase",
        "title": "%command.toKebabCase.title%"
      },
      {
        "command": "variable-conversion.toKebabUpperCase",
        "title": "%command.toKebabUpperCase.title%"
      },
      {
        "command": "variable-conversion.toKebabPascalCase",
        "title": "%command.toKebabPascalCase.title%"
      },
      {
        "command": "variable-conversion.toKebabCamelCase",
        "title": "%command.toKebabCamelCase.title%"
      },
      {
        "command": "variable-conversion.toSpaceCase",
        "title": "%command.toSpaceCase.title%"
      },
      {
        "command": "variable-conversion.toSpaceUpperCase",
        "title": "%command.toSpaceUpperCase.title%"
      },
      {
        "command": "variable-conversion.toSpacePascalCase",
        "title": "%command.toSpacePascalCase.title%"
      },
      {
        "command": "variable-conversion.toSpaceCamelCase",
        "title": "%command.toSpaceCamelCase.title%"
      },
      {
        "command": "variable-conversion.toDotCase",
        "title": "%command.toDotCase.title%"
      },
      {
        "command": "variable-conversion.toDotUpperCase",
        "title": "%command.toDotUpperCase.title%"
      },
      {
        "command": "variable-conversion.toDotPascalCase",
        "title": "%command.toDotPascalCase.title%"
      },
      {
        "command": "variable-conversion.toDotCamelCase",
        "title": "%command.toDotCamelCase.title%"
      },
      {
        "command": "variable-conversion.toLowerCase",
        "title": "%command.toLowerCase.title%"
      },
      {
        "command": "variable-conversion.toUpperCase",
        "title": "%command.toUpperCase.title%"
      },
      {
        "command": "variable-conversion.convertPath",
        "title": "%command.convertPath.title%"
      },
      {
        "command": "variable-conversion.cyclicConvertPath.previous",
        "title": "%command.cyclicConvertPath.previous.title%"
      },
      {
        "command": "variable-conversion.cyclicConvertPath.next",
        "title": "%command.cyclicConvertPath.next.title%"
      },
      {
        "command": "variable-conversion.pathFormat.toWindowsStyle",
        "title": "%command.pathFormat.toWindowsStyle.title%"
      },
      {
        "command": "variable-conversion.pathFormat.toUnixStyle",
        "title": "%command.pathFormat.toUnixStyle.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && _textSelectionLength >= 1",
          "command": "variable-conversion.convertCase",
          "group": "navigation@10"
        },
        {
          "when": "editorTextFocus && _textSelectionLength >= 1",
          "submenu": "variable-conversion.stringConversionMenu",
          "group": "navigation@11"
        },
        {
          "when": "editorTextFocus && _textSelectionLength >= 1",
          "command": "variable-conversion.convertPath",
          "group": "navigation@12"
        },
        {
          "when": "editorTextFocus && _textSelectionLength >= 1",
          "submenu": "variable-conversion.pathConversionMenu",
          "group": "navigation@13"
        }
      ],
      "variable-conversion.stringConversionMenu": [
        {
          "when": "!_isHideSubMenuItem_camel_case",
          "command": "variable-conversion.toCamelCase",
          "group": "group-1-camel@1"
        },
        {
          "when": "!_isHideSubMenuItem_pascal_case",
          "command": "variable-conversion.toPascalCase",
          "group": "group-1-camel@2"
        },
        {
          "when": "!_isHideSubMenuItem_snake_case",
          "command": "variable-conversion.toSnakeCase",
          "group": "group-2-snake@1"
        },
        {
          "when": "!_isHideSubMenuItem_snake_upper_case",
          "command": "variable-conversion.toSnakeUpperCase",
          "group": "group-2-snake@2"
        },
        {
          "when": "!_isHideSubMenuItem_snake_pascal_case",
          "command": "variable-conversion.toSnakePascalCase",
          "group": "group-2-snake@3"
        },
        {
          "when": "!_isHideSubMenuItem_snake_camel_case",
          "command": "variable-conversion.toSnakeCamelCase",
          "group": "group-2-snake@4"
        },
        {
          "when": "!_isHideSubMenuItem_kebab_case",
          "command": "variable-conversion.toKebabCase",
          "group": "group-3-kebab@1"
        },
        {
          "when": "!_isHideSubMenuItem_kebab_upper_case",
          "command": "variable-conversion.toKebabUpperCase",
          "group": "group-3-kebab@2"
        },
        {
          "when": "!_isHideSubMenuItem_kebab_pascal_case",
          "command": "variable-conversion.toKebabPascalCase",
          "group": "group-3-kebab@3"
        },
        {
          "when": "!_isHideSubMenuItem_kebab_camel_case",
          "command": "variable-conversion.toKebabCamelCase",
          "group": "group-3-kebab@4"
        },
        {
          "when": "!_isHideSubMenuItem_space_case",
          "command": "variable-conversion.toSpaceCase",
          "group": "group-4-space@1"
        },
        {
          "when": "!_isHideSubMenuItem_space_upper_case",
          "command": "variable-conversion.toSpaceUpperCase",
          "group": "group-4-space@2"
        },
        {
          "when": "!_isHideSubMenuItem_space_pascal_case",
          "command": "variable-conversion.toSpacePascalCase",
          "group": "group-4-space@3"
        },
        {
          "when": "!_isHideSubMenuItem_space_camel_case",
          "command": "variable-conversion.toSpaceCamelCase",
          "group": "group-4-space@4"
        },
        {
          "when": "!_isHideSubMenuItem_dot_case",
          "command": "variable-conversion.toDotCase",
          "group": "group-5-dot@1"
        },
        {
          "when": "!_isHideSubMenuItem_dot_upper_case",
          "command": "variable-conversion.toDotUpperCase",
          "group": "group-5-dot@2"
        },
        {
          "when": "!_isHideSubMenuItem_dot_pascal_case",
          "command": "variable-conversion.toDotPascalCase",
          "group": "group-5-dot@3"
        },
        {
          "when": "!_isHideSubMenuItem_dot_camel_case",
          "command": "variable-conversion.toDotCamelCase",
          "group": "group-5-dot@4"
        },
        {
          "when": "!_isHideSubMenuItem_lower_case",
          "command": "variable-conversion.toLowerCase",
          "group": "group-6-upper-lower@1"
        },
        {
          "when": "!_isHideSubMenuItem_upper_case",
          "command": "variable-conversion.toUpperCase",
          "group": "group-6-upper-lower@2"
        }
      ],
      "variable-conversion.pathConversionMenu": [
        {
          "when": "!_isHideSubMenuItem_windows_style",
          "command": "variable-conversion.pathFormat.toWindowsStyle",
          "group": "group-1-common-style@1"
        },
        {
          "when": "!_isHideSubMenuItem_unix_style",
          "command": "variable-conversion.pathFormat.toUnixStyle",
          "group": "group-1-common-style@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "variable-conversion.stringConversionMenu",
        "label": "%submenu.stringConversion.label%"
      },
      {
        "id": "variable-conversion.pathConversionMenu",
        "label": "%submenu.pathConversion.label%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "variable-conversion.enabledFormats": {
          "type": "object",
          "markdownDescription": "%configuration.enabledFormats.markdownDescription%",
          "scope": "window",
          "properties": {
            "lowerCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.lowerCase.description%"
            },
            "snakeCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.snakeCase.description%"
            },
            "kebabCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.kebabCase.description%"
            },
            "spaceCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.spaceCase.description%"
            },
            "dotCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.dotCase.description%"
            },
            "upperCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.upperCase.description%"
            },
            "snakeUpperCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.snakeUpperCase.description%"
            },
            "kebabUpperCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.kebabUpperCase.description%"
            },
            "spaceUpperCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.spaceUpperCase.description%"
            },
            "dotUpperCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.dotUpperCase.description%"
            },
            "pascalCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.pascalCase.description%"
            },
            "snakePascalCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.snakePascalCase.description%"
            },
            "kebabPascalCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.kebabPascalCase.description%"
            },
            "spacePascalCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.spacePascalCase.description%"
            },
            "dotPascalCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.dotPascalCase.description%"
            },
            "camelCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.camelCase.description%"
            },
            "snakeCamelCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.snakeCamelCase.description%"
            },
            "kebabCamelCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.kebabCamelCase.description%"
            },
            "spaceCamelCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.spaceCamelCase.description%"
            },
            "dotCamelCase.enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.enabledFormats.dotCamelCase.description%"
            }
          },
          "additionalProperties": false,
          "default": {
            "lowerCase.enabled": true,
            "snakeCase.enabled": true,
            "kebabCase.enabled": true,
            "spaceCase.enabled": true,
            "dotCase.enabled": false,
            "upperCase.enabled": true,
            "snakeUpperCase.enabled": true,
            "kebabUpperCase.enabled": false,
            "spaceUpperCase.enabled": true,
            "dotUpperCase.enabled": false,
            "pascalCase.enabled": true,
            "snakePascalCase.enabled": false,
            "kebabPascalCase.enabled": false,
            "spacePascalCase.enabled": false,
            "dotPascalCase.enabled": false,
            "camelCase.enabled": true,
            "snakeCamelCase.enabled": false,
            "kebabCamelCase.enabled": false,
            "spaceCamelCase.enabled": false,
            "dotCamelCase.enabled": false
          }
        },
        "variable-conversion.formatOrder": {
          "type": "array",
          "markdownDescription": "%configuration.formatOrder.markdownDescription%",
          "scope": "window",
          "items": {
            "type": "string",
            "enum": [
              "camel_case",
              "pascal_case",
              "snake_case",
              "snake_camel_case",
              "snake_pascal_case",
              "snake_upper_case",
              "kebab_case",
              "kebab_camel_case",
              "kebab_pascal_case",
              "kebab_upper_case",
              "space_case",
              "space_camel_case",
              "space_pascal_case",
              "space_upper_case",
              "dot_case",
              "dot_camel_case",
              "dot_pascal_case",
              "dot_upper_case",
              "lower_case",
              "upper_case"
            ],
            "enumDescriptions": [
              "%enum.variableCase.camel_case%",
              "%enum.variableCase.pascal_case%",
              "%enum.variableCase.snake_case%",
              "%enum.variableCase.snake_camel_case%",
              "%enum.variableCase.snake_pascal_case%",
              "%enum.variableCase.snake_upper_case%",
              "%enum.variableCase.kebab_case%",
              "%enum.variableCase.kebab_camel_case%",
              "%enum.variableCase.kebab_pascal_case%",
              "%enum.variableCase.kebab_upper_case%",
              "%enum.variableCase.space_case%",
              "%enum.variableCase.space_camel_case%",
              "%enum.variableCase.space_pascal_case%",
              "%enum.variableCase.space_upper_case%",
              "%enum.variableCase.dot_case%",
              "%enum.variableCase.dot_camel_case%",
              "%enum.variableCase.dot_pascal_case%",
              "%enum.variableCase.dot_upper_case%",
              "%enum.variableCase.lower_case%",
              "%enum.variableCase.upper_case%"
            ]
          },
          "default": []
        },
        "variable-conversion.enabledPathFormats": {
          "type": "object",
          "markdownDescription": "%configuration.enabledPathFormats.markdownDescription%",
          "scope": "window",
          "properties": {
            "windowsStyle.enabled": {
              "type": "boolean",
              "default": true,
              "description": "%configuration.enabledPathFormats.windowsStyle.description%"
            },
            "unixStyle.enabled": {
              "type": "boolean",
              "default": true,
              "description": "%configuration.enabledPathFormats.unixStyle.description%"
            }
          },
          "additionalProperties": false,
          "default": {
            "windowsStyle.enabled": true,
            "unixStyle.enabled": true
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint && pnpm run check:i18n",
    "lint": "eslint src",
    "check:i18n": "node scripts/check-i18n.mjs",
    "changelog": "node scripts/changelog.mjs",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "test": "vscode-test",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish & npx ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.100.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
